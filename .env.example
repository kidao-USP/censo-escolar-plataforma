# Copie para .env e GERE senhas fortes (nao reutilize estas, nao use aspas):
#   openssl rand -hex 24
POSTGRES_DB=censo
POSTGRES_USER=censo_admin
POSTGRES_PASSWORD=troque-esta-senha-admin
API_DB_PASSWORD=troque-esta-senha-api

# Endereco publico do site (HTTPS automatico via Caddy/Let's Encrypt).
# Producao: oipp.each.usp.br   |   Teste local: localhost
SITE_ADDRESS=oipp.each.usp.br

# Anos do Censo Escolar a carregar. Hoje: 2023 e 2024 (CSV por escola, formato compativel com o ETL).
# 2025 ainda nao: o Inep mudou o formato (ver README, "Anos e limitacoes").
CENSO_ANOS=2023 2024
# URL do ZIP de microdados; {ano} e substituido. Se o download automatico
# falhar, baixe o ZIP no site do Inep e salve em ./data/microdados_censo_escolar_<ano>.zip
CENSO_URL_TEMPLATE=https://download.inep.gov.br/dados_abertos/microdados_censo_escolar_{ano}.zip
