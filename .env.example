# Copie para .env e troque as senhas (use apenas letras e numeros, sem aspas).
POSTGRES_DB=censo
POSTGRES_USER=censo_admin
POSTGRES_PASSWORD=troque-esta-senha-admin
API_DB_PASSWORD=troque-esta-senha-api

# Porta publicada pelo frontend (nginx)
WEB_PORT=8080

# Anos do Censo Escolar a carregar (os 2 ultimos)
CENSO_ANOS=2024 2025
# URL do ZIP de microdados; {ano} e substituido. Se o download automatico
# falhar, baixe o ZIP no site do Inep e salve em ./data/microdados_censo_escolar_<ano>.zip
CENSO_URL_TEMPLATE=https://download.inep.gov.br/dados_abertos/microdados_censo_escolar_{ano}.zip
